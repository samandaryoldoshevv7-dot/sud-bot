# =====================================================================
# Court training bot — environment variables
# Copy to .env for local development. On Railway set them in "Variables".
# NEVER commit real values.
# =====================================================================

# --- REQUIRED ---------------------------------------------------------
# Telegram bot token from @BotFather
BOT_TOKEN=
# Groq API key (https://console.groq.com/keys). Without it AI question generation is disabled
# (tests can still be built from already approved questions in the question bank).
GROQ_API_KEY=
# PostgreSQL connection string. On Railway use the reference: ${{Postgres.DATABASE_URL}}
DATABASE_URL=postgresql://court:court_dev_password@localhost:5432/court_bot
# Comma-separated Telegram user IDs of administrators (get yours from @userinfobot)
ADMIN_TELEGRAM_IDS=123456789,987654321
# (ADMIN_IDS is accepted as an alias of ADMIN_TELEGRAM_IDS)
# Display timezone (all timestamps are stored in UTC)
TIMEZONE=Asia/Tashkent

# --- AI (Groq) --------------------------------------------------------
GROQ_MODEL=openai/gpt-oss-120b
# Used automatically if GROQ_MODEL is retired/unavailable (Groq retires models regularly)
GROQ_FALLBACK_MODELS=openai/gpt-oss-20b,qwen/qwen3-32b,llama-3.1-8b-instant
# Optional separate model for verification/validation calls (defaults to GROQ_MODEL)
GROQ_VALIDATION_MODEL=
GROQ_TEMPERATURE=0.3
GROQ_TIMEOUT_SECONDS=60
AI_MAX_RETRIES=3
# Minimum verifier confidence (0..1) for a generated question to be accepted
AI_MIN_CONFIDENCE=0.7
# Minimum fuzzy similarity (0..100) between the AI excerpt and the real source text
AI_EXCERPT_MIN_SIMILARITY=88
AI_QUESTIONS_PER_CHUNK=2

# --- Embeddings / RAG (no API key needed: runs locally via ONNX) -------
# fastembed = local multilingual model (baked into the Docker image); none = full-text search only
GROQ_MAX_CONCURRENCY=2
AI_CACHE_TTL_SECONDS=21600
EMBEDDING_PROVIDER=fastembed
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
# Must match the model output size. Changing it requires a new database (vector column size).
EMBEDDING_DIM=384
EMBEDDING_CACHE_DIR=/app/models_cache
CHUNK_SIZE=1200
CHUNK_OVERLAP=200

# --- Telegram delivery mode -------------------------------------------
# polling (recommended on Railway, no public domain needed) or webhook
BOT_MODE=polling
# Webhook mode only: public https base URL (e.g. https://your-app.up.railway.app) and secret
WEBHOOK_BASE_URL=
WEBHOOK_PATH=/telegram/webhook
WEBHOOK_SECRET=
# Optional self-hosted Telegram Bot API server
TELEGRAM_API_BASE=

# --- Runtime ----------------------------------------------------------
# Railway injects PORT automatically; /health is served on it
PORT=8080
LOG_LEVEL=INFO
LOG_FORMAT=json
MAX_FILE_SIZE_MB=20
SCHEDULER_INTERVAL_SECONDS=60
# Enough connections for hundreds of employees answering at the same time
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
